### Terraform ###

# Local Terraform working directories containing downloaded providers/modules
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*

# State lock metadata
.terraform.tfstate.lock.info

# Terraform plan files
*.tfplan
tfplan

# Local variable files, which may contain environment-specific values or secrets
*.tfvars
*.tfvars.json

# Keep safe example variable files
!*.tfvars.example

# Crash output
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Local Terraform CLI configuration
.terraformrc
terraform.rc

# Temporary Google GitHub Actions credential files
gha-creds-*.json

# Temporary secret files
db-password.txt
