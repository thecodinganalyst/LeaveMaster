project_id = "your-project-id"

region = "asia-southeast1"

database_host = "aws-0-ap-southeast-1.pooler.supabase.com"

database_username = "postgres.your-project-ref"

database_name = "postgres"

image_tag = "replace-with-git-sha"

deploy_service = false

enable_ai_assistant        = false
ai_assistant_provider      = "openai"
ai_assistant_model         = "gpt-5-mini"
openai_api_key_secret_id   = "leavemaster-openai-api-key"
gemini_api_key_secret_id   = "leavemaster-gemini-api-key"

# Transactional email. Create the named Secret Manager secret separately and add
# the Resend API key as a secret version; never put the API key in this file.
email_provider           = "resend"
resend_api_key_secret_id = "leavemaster-resend-api-key"
email_from_address       = "onboarding@resend.dev"
email_from_name          = "LeaveMaster"

# OAuth client IDs are non-secret deployment configuration. Store the client
# secrets in Secret Manager and reference only their secret IDs here.
github_oauth_client_id        = "your-github-oauth-client-id"
github_oauth_client_secret_id = "leavemaster-github-oauth-client-secret"
google_oauth_client_id        = "your-google-oauth-client-id"
google_oauth_client_secret_id = "leavemaster-google-oauth-client-secret"
