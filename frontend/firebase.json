{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "firebase.ci.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/auth/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/oauth2/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/login/oauth2/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/login",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/logout",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/tenants",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/tenants/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/users",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/users/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/roles",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/roles/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/staff",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/staff/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/locations",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/locations/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/leave-types",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/leave-types/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/leave-approvers",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/leave-approvers/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/leave-calendars",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/leave-calendars/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/leave-applications",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/leave-applications/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
