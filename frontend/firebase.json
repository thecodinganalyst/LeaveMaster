{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "firebase.ci.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/auth/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/oauth2/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/login/oauth2/**",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/login",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "/logout",
        "run": {
          "serviceId": "leavemaster-api",
          "region": "asia-southeast1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public,max-age=31536000,immutable"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
