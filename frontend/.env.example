# Local development: Vite runs on http://localhost:5173 and calls the local backend.
VITE_API_URL=http://localhost:8080

# Production Firebase Hosting normally leaves VITE_API_URL unset.
# The browser then calls the same Hosting origin and Firebase rewrites backend routes to Cloud Run.
# Never put database, OpenAI, OAuth client-secret, or other backend secrets in VITE_* variables.
